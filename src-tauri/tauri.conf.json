{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm",
  "version": "0.1.2",
  "identifier": "com.hexadev.swarm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Swarm",
        "width": 1440,
        "height": 940,
        "minWidth": 860,
        "minHeight": 580,
        "backgroundColor": "#1c1c1b",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 29.5
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "$HOME/**",
          "$APPDATA/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$PICTURES/**",
          "$VIDEOS/**",
          "/tmp/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost blob:; media-src 'self' data: asset: http://asset.localhost https://asset.localhost blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage",
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Lightweight coding agent workspace",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3OEQ0RkYwQ0I4QzRGODEKUldTQlQ0ekw4RStOTnhNYW9jL1pTZENocVU3TGNPeVVxcDdzdkN4d0s3R2lPekxGRitGLzVwM3oK",
      "endpoints": [
        "https://github.com/HexaDev-De/Swarm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
