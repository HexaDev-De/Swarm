---
/* Open source: what "free and open source" means in practice, and how to build PandaCode from
 * source. Commands mirror the repository README (`npm run desktop` runs `tauri dev`). */
import { project } from '../lib/distribution';
const facts = [
  ['Free, for good.', 'No subscription, no trial, no paid tier. Every feature is in the download.'],
  ['MIT-based license.', 'Use it, change it, ship it. Forks just say where they came from.'],
  ['No account.', 'Nothing to sign up for and no license key. Open the app and start.'],
  ['No telemetry.', 'No analytics, crash reports or usage tracking. Not in the app, not on this site.'],
  ['Bring your own agents.', 'Claude Code, Codex, Kimi Code, OpenCode and more, signed in with your own accounts.'],
  ['Built in the open.', 'Report bugs, suggest ideas and send pull requests on GitHub.'],
];
const steps = [
  ['git clone', project.clone],
  ['cd', 'pandacode'],
  ['npm ci', ''],
  ['npm run desktop', ''],
];
---
<section id="open-source" class="open-source section-width" aria-labelledby="open-source-title">
  <div class="section-heading reveal">
    <p class="eyebrow">FREE & OPEN SOURCE</p>
    <h2 id="open-source-title">Free to use.<br>Open to everyone.</h2>
    <p>PandaCode belongs to the people who use it. Read every line, build it yourself, and help it grow.</p>
  </div>
  <div class="oss-layout">
    <ul class="oss-facts">
      {facts.map(([title, text]) => <li><span class="oss-leaf" aria-hidden="true"></span><b>{title}</b><span>{text}</span></li>)}
    </ul>
    <div class="oss-build">
      <div class="oss-terminal" role="group" aria-labelledby="oss-build-title">
        <div class="oss-terminal-bar" aria-hidden="true"><i></i><i></i><i></i><span>Terminal</span></div>
        <h3 id="oss-build-title">Build from source</h3>
        <pre><code>{steps.map(([command, argument]) => <span class="oss-line"><span class="oss-prompt" aria-hidden="true">$ </span>{command}{argument && ` ${argument}`}</span>)}</code></pre>
        <p>Needs Node.js 22+, Rust and the <a href="https://v2.tauri.app/start/prerequisites/" target="_blank" rel="noopener noreferrer">Tauri prerequisites</a> for your platform.</p>
      </div>
      <div class="oss-links">
        <a class="button" href={project.repo} target="_blank" rel="noopener noreferrer" data-source>Star on GitHub <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={project.issues} target="_blank" rel="noopener noreferrer">Contribute <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/license/">Read the license <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .open-source { padding-block: 40px 110px; }
  .section-heading { max-width: 740px; margin: 0 auto 52px; text-align: center; }
  .section-heading > p:last-child { max-width: 520px; margin: 24px auto 0; color: var(--muted); font-size: 17px; }
  .oss-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 5%; align-items: start; }
  .oss-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
  .oss-facts li { position: relative; padding: 20px 20px 20px 46px; border-radius: 18px; background: #fffefa; box-shadow: 0 0 0 1px #dce2d3, 0 12px 30px -26px #31452866; transition: transform .35s cubic-bezier(.2,.9,.25,1.3), box-shadow .35s; }
  .oss-facts li:hover { transform: translateY(-3px); box-shadow: 0 0 0 1px #cbd5b8, 0 18px 34px -22px #31452877; }
  .oss-leaf { position: absolute; left: 20px; top: 25px; width: 13px; height: 7px; border-radius: 0 100% 0 100%; background: linear-gradient(135deg, #a9c47f, #6f8f4e); }
  .oss-facts b { display: block; margin-bottom: 4px; font-size: 15px; letter-spacing: -.015em; }
  .oss-facts span:last-child { font-size: 13px; line-height: 1.6; color: #50604a; }
  .oss-terminal { padding: 0 0 22px; border-radius: 20px; background: #17302a; color: #e5eedb; box-shadow: 0 24px 50px -30px #0b2319aa; overflow: hidden; }
  .oss-terminal-bar { display: flex; align-items: center; gap: 7px; padding: 13px 16px; background: #ffffff0d; font-size: 11px; color: #a9bb9c; }
  .oss-terminal-bar i { width: 10px; height: 10px; border-radius: 50%; background: #ffffff24; }
  .oss-terminal-bar span { margin-left: 8px; }
  .oss-terminal h3 { padding: 18px 22px 0; font-size: 17px; letter-spacing: -.02em; color: #f5f6ea; }
  pre { margin: 12px 0 0; padding: 0 22px; overflow-x: auto; font: 13px/2 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .oss-line { display: block; white-space: pre; }
  .oss-prompt { color: var(--yellow); }
  .oss-terminal p { padding: 14px 22px 0; font-size: 12px; line-height: 1.6; color: #b9c9ad; }
  .oss-terminal a { color: #f5f6ea; text-decoration: underline; text-underline-offset: 3px; }
  .oss-links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 24px; }
  @media (max-width: 960px) { .oss-layout { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
  @media (max-width: 760px) {
    .open-source { padding-block: 10px 70px; }
    .section-heading { text-align: left; margin-bottom: 30px; }
    .section-heading > p:last-child { font-size: 16px; margin-inline: 0; }
    .oss-facts { grid-template-columns: minmax(0, 1fr); }
    pre { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .oss-facts li { transition: none; } .oss-facts li:hover { transform: none; } }
</style>
